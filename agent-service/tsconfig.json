{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "allowJs": true, "checkJs": false,
    "resolveJsonModule": true, "strict": true, "skipLibCheck": true,
    "noEmit": true, "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*"]
}
