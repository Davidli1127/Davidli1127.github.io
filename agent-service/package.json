{
  "name": "david-portfolio-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
